{
    "name": "camada/camada-php-example",
    "description": "A plain-PHP front controller wired with camada against a local edge-analyst: the hand-test bench for the PHP SDK.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../camada-php" }
    ],
    "require": {
        "php": ">=8.1",
        "camada/camada": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11 || ^12"
    },
    "autoload-dev": {
        "psr-4": {
            "CamadaExample\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "PHP_CLI_SERVER_WORKERS=4 php -S 127.0.0.1:3005 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
